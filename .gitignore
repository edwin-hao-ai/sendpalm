# MDDock local metadata (do not commit)
.mddock/*
# …but keep the workspace manifest tracked
!.mddock/mddock.md

# Node dependencies installed for local verification only
node_modules/

# macOS metadata
.DS_Store

# Temporary verification screenshots and scratch files
qa-tmp/*
!.gitkeep

# Subagent-driven development scratch files
.superpowers/sdd/

# Playwright / Vitest artifacts
app/test-results/
app/e2e-report/
app/coverage/

# Tauri build artifacts
app/src-tauri/target/
app/src-tauri/gen/
app/dist/

# Tauri local SQLite db (debug only — production lives in user data dir)
app/dev.db
app/dev.db-journal
