# SendPalm test environment variables
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit credentials.
#
# Test mail account (provided by user — see AGENTS.md §10 "Test credentials"):
#   email:     edwinhao@sendpalm.com
#   IMAP host: imap.feishu.cn:993 (SSL)
#   SMTP host: smtp.feishu.cn:465 (SSL)
#   password:  app-specific password, NOT the account password

# Account
SENDPALM_TEST_EMAIL=edwinhao@sendpalm.com
SENDPALM_TEST_PASSWORD=

# IMAP
SENDPALM_TEST_IMAP_HOST=imap.feishu.cn
SENDPALM_TEST_IMAP_PORT=993

# SMTP
SENDPALM_TEST_SMTP_HOST=smtp.feishu.cn
SENDPALM_TEST_SMTP_PORT=465