{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "comment": "macOS 系统设置的深链（通知权限被拒时引导用户去允许）",
      "allow": [{ "url": "x-apple.systempreferences:*" }]
    },
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "store:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "store:allow-load",
    "store:allow-delete",
    "store:allow-clear",
    "dialog:default",
    "notification:default",
    "fs:default",
    "clipboard-manager:default",
    "os:default"
  ]
}